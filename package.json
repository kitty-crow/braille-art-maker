{
  "name": "@kitty-crow/unicode-art-maker",
  "version": "0.3.0",
  "description": "PNG to dense Unicode art for Bun and the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Kitty Crow <kitty@kittycrow.dev> (https://kittycrow.dev)",
  "repository": "github:kitty-crow/braille-art-maker",
  "homepage": "https://kitty-crow.github.io/braille-art-maker/",
  "bin": { "unicode-art": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "clean": "rm -rf dist site .pages-cache",
    "version:check": "bun vendor/pages/src/cli.ts version check",
    "pages:check": "bun vendor/pages/src/cli.ts check pages.config.ts",
    "check:c": "cc -std=c11 -Wall -Wextra -Wpedantic -Werror extras/term/unicode-colour-view.c -o /tmp/unicode-colour-view",
    "check": "bun run version:check && bun run pages:check && bunx tsc --noEmit && bun run check:c && bun run test",
    "test": "bun test tests/core.test.ts tests/colour.test.ts tests/vector.test.ts tests/web.test.ts",
    "build": "bun src/build.ts",
    "site:build": "bun src/build.ts",
    "site:dev": "bun src/build.ts && bun src/serve.ts",
    "cli": "bun src/cli.ts"
  },
  "dependencies": { "pngjs": "7.0.0" },
  "devDependencies": { "@types/bun": "1.3.14", "@types/pngjs": "6.0.5", "typescript": "5.9.3" },
  "engines": { "bun": ">=1.3.14" }
}
